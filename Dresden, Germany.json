  "reviews": [
    {
      "reviewerId": "112763975803727887014",
      "reviewerUrl": "https://www.google.com/maps/contrib/112763975803727887014?hl=en",
      "name": "Bünyamin Gündüz",
      "reviewerNumberOfReviews": 101,
      "isLocalGuide": true,
      "reviewerPhotoUrl": "https://lh3.googleusercontent.com/a-/ALV-UjWmmJEBHfrM2rG64ADa7d-rzorbE5-UPB2XwgRW8IvEk-yFyi3O=s1920-c-rp-mo-ba12-br100",
      "text": "Müslümanların namaz ve diğer bir çok aktivite için toplanabileceği güzel bir mekan. Türkiyede camilerde olmayan imkanlar mevcut. Çocuklar ve gençler dülünülmüş.",
      "textTranslated": "It's a beautiful place where Muslims can gather for prayer and many other activities. It has facilities that are not available in mosques in Türkiye. Children and young people have been thought of.",
      "publishAt": "2 weeks ago",
      "publishedAtDate": "2026-09-10T06:12:11.124Z",
      "likesCount": 0,
      "reviewId": "Ci9DQUlRQUNvZENodHljRjlvT25neGFFaHBVbTh0VFUxeVdqY3RNVkpUWW5KR1gwRRAB",
      "reviewUrl": "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25neGFFaHBVbTh0VFUxeVdqY3RNVkpUWW5KR1gwRRAB!2m1!1s0x0:0x2ea35441794f1202!3m1!1s2@1:CAIQACodChtycF9oOngxaEhpUm8tTU1yWjctMVJTYnJGX0E%7C%7C?hl=en",
      "reviewOrigin": "Google",
